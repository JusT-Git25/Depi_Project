# Copy this file to ".env" and put your own key in it. ".env" is git-ignored.
# The advisor supports Anthropic (Claude), Google Gemini, or OpenAI.
ANTHROPIC_API_KEY=your-anthropic-key-here

# Alternatively, configure Google Gemini or OpenAI:
# GEMINI_API_KEY=your-gemini-key-here
# OPENAI_API_KEY=your-openai-key-here

# Optional: explicitly choose provider ("anthropic", "gemini", or "openai")
# AI_PROVIDER=anthropic

# Optional: custom model name (defaults: claude-haiku-5-5, gemini-1.5-flash, or gpt-4o-mini)
# AI_MODEL=claude-haiku-5-5

