# ==============================================================================
# Liver Disease Prediction API — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development and set a strong secret key.
# NEVER commit `.env` or real API keys to version control.
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ==============================================================================

# Required API key sent by clients in the `X-API-Key` HTTP header
LIVER_API_KEY=replace-with-a-strong-random-api-key-min-32-chars

# FastAPI service settings
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# CORS allowed origins (comma-separated, e.g. http://localhost:8501,https://app.example.com)
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Path to serialized model artifact bundle (relative to project root or absolute)
MODEL_ARTIFACT_PATH=artifacts/models/liver_disease_pipeline.joblib

# Maximum CSV rows accepted in a single /predict/batch request
MAX_BATCH_ROWS=5000

# Streamlit frontend configuration (used by frontend/app.py)
API_BASE_URL=http://localhost:8000
